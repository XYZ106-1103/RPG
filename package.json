{
  "name": "ashen-lantern",
  "private": true,
  "version": "0.1.0",
  "description": "꺼진 등불의 땅 (가제) — 웹 브라우저 소울라이크 액션 오픈월드 RPG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tools --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:input": "node tools/e2e/input-smoke.mjs",
    "check:credits": "node tools/check_credits.mjs",
    "assets:polyhaven": "node tools/fetch_polyhaven.mjs",
    "assets:ambientcg": "node tools/fetch_ambientcg.mjs",
    "assets:orm": "node tools/pack_orm.mjs",
    "assets:optimize": "node tools/optimize.mjs",
    "prepare": "node tools/setup_hooks.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYZ106-1103/shooter-multiplay.git"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.2",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "9.33.2",
    "@babylonjs/materials": "9.33.2",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
